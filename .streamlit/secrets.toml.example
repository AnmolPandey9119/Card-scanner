# Local use: copy this file to .streamlit/secrets.toml and fill it.
# Deployed: paste the same lines in your host's "Secrets" box.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY = "AIza-your-key-here"
# Free backup, no card: https://console.groq.com/keys (used automatically when Gemini limit is over)
GROQ_API_KEY = "gsk_your-key-here"
APP_PASSWORD = "choose-a-strong-password"
# Optional: override the default model list (comma separated = fallback order)
# GEMINI_MODEL = "gemini-3.8-flash"
# Optional: GROQ_MODEL = "meta-llama/llama-4-scout-17b-16e-instruct"
